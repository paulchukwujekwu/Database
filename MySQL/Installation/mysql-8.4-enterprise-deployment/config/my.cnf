############################################################
# MySQL Enterprise Server 8.4 Configuration
# Production-Oriented Reference Configuration
############################################################

# NOTE:
# This configuration is provided for educational and portfolio
# purposes. Memory, I/O, and connection parameters should be
# adjusted based on server sizing and workload requirements.

############################################################
# CLIENT SETTINGS
############################################################
[client]
socket = /run/mysql/mysql.sock

############################################################
# MYSQL COMMAND LINE CLIENT
############################################################
[mysql]
socket = /run/mysql/mysql.sock

############################################################
# SERVER SETTINGS
############################################################
[mysqld]

############################################################
# BASIC CONFIGURATION
############################################################
user                = mysql
basedir             = /mysql/mysql/mysql
datadir             = /mysql/mysqldata
socket              = /run/mysql/mysql.sock
pid-file            = /run/mysql/mysql.pid
port                = 3306

# Restrict as appropriate in production
bind-address        = 0.0.0.0

############################################################
# GENERAL BEHAVIOR
############################################################
lower_case_table_names          = 1
restrict_fk_on_non_standard_key = OFF

############################################################
# ERROR LOGGING
############################################################
log-error = /mysql/log/error.log

############################################################
# SLOW QUERY LOGGING
############################################################
slow_query_log      = ON
slow_query_log_file = /mysql/log/slow.log
long_query_time     = 2

############################################################
# BINARY LOGGING
############################################################
log_bin                    = /mysql/mysqlbin/mysql-bin
binlog_format              = ROW
binlog_expire_logs_seconds = 1209600

############################################################
# SECURITY
############################################################
local_infile   = OFF
symbolic-links = 0

############################################################
# CHARACTER SET
############################################################
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

############################################################
# CONNECTION MANAGEMENT
############################################################
max_connections = 500

############################################################
# SESSION BUFFERS
############################################################
join_buffer_size    = 2M
sort_buffer_size    = 2M
tmp_table_size      = 64M
max_heap_table_size = 64M

############################################################
# INNODB CONFIGURATION
############################################################

# Adjust according to available server memory
innodb_buffer_pool_size      = 120G
innodb_buffer_pool_instances = 32

# Redo Logging
innodb_log_buffer_size   = 128M
innodb_redo_log_capacity = 8G

# Storage & I/O
innodb_file_per_table          = ON
innodb_flush_method            = O_DIRECT
innodb_flush_log_at_trx_commit = 2

# I/O Capacity
innodb_io_capacity     = 6000
innodb_io_capacity_max = 10000

# Thread Management
innodb_thread_concurrency = 0
